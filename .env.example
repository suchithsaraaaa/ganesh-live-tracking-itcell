# ==============================================================================
# Hyderabad Police Ganesh Visarjan Live Tracking System
# Production Environment Variables Template (.env.example)
#
# INSTRUCTIONS:
# 1. On the production EC2 instance, copy this template to .env:
#      cp .env.example .env
# 2. Populate strong, unique values for each required variable.
# 3. Secure file permissions on the production host (e.g., chmod 600 .env).
# 4. NEVER commit real secrets or the .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Security & Django Core (REQUIRED)
# ------------------------------------------------------------------------------
# Cryptographically strong Django secret key (e.g., python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=change-me-to-a-secure-random-50-char-secret-key

# Comma-separated list of fully qualified domain names and/or IP addresses for EC2 deployment
# Example: ALLOWED_HOSTS=tracking.hyderabadpolice.gov.in,13.235.12.34
ALLOWED_HOSTS=your-ec2-ip-or-domain.example.com

# ------------------------------------------------------------------------------
# PostgreSQL / PostGIS Database (REQUIRED)
# ------------------------------------------------------------------------------
DB_NAME=ganesh_tracking
DB_USER=postgres
DB_PASSWORD=change-me-to-a-strong-database-password

# ------------------------------------------------------------------------------
# AWS S3 Storage for Operational PDF Reports (OPTIONAL)
# When deployed on AWS EC2 with an attached IAM Role, AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY are NOT required. boto3 will automatically use the
# default AWS credential provider chain (EC2 Instance Metadata Service / IAM role).
# ------------------------------------------------------------------------------
AWS_STORAGE_BUCKET_NAME=your-police-s3-report-bucket-name
AWS_S3_REGION_NAME=ap-south-1

# Optional production cookies security flag (set to True when TLS/SSL termination is active)
SECURE_COOKIES=False
