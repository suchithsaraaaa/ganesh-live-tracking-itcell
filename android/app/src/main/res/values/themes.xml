<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.VisarjanTracking" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/base</item>
        <item name="android:navigationBarColor">@color/base</item>
        <item name="android:windowBackground">@color/base</item>
    </style>

    <!-- Cold-start splash (androidx.core.splashscreen) — same mark as the
         launcher icon, on the same base background, so app-open feels like
         one continuous piece of branding rather than a generic white flash.
         MainActivity sets this as its manifest theme and calls
         installSplashScreen() before super.onCreate(); the library switches
         to postSplashScreenTheme automatically once content is drawn. -->
    <style name="Theme.VisarjanTracking.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/base</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.VisarjanTracking</item>
    </style>
</resources>
